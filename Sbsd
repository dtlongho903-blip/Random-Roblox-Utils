-----------------------------------------------------
local isAutoReviveToggled = false

local function autoReviveLoop()
    task.spawn(function()
        while isAutoReviveToggled do
            local allPlayers = Players:GetPlayers()
            for _, player in ipairs(allPlayers) do
                if not isAutoReviveToggled then break end
                
                if player ~= LocalPlayer then
                    pcall(function()
                        local charName = player.Name
                        local char = workspace:FindFirstChild(charName)
                        if char then
                            local head = char:FindFirstChild("Head")
                            if head then
                                local revivePrompt = head:FindFirstChild("Revive")
                                if revivePrompt and revivePrompt:IsA("ProximityPrompt") then
                                    if fireproximityprompt then
                                        fireproximityprompt(revivePrompt)
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(0.1)
                end
            end
            task.wait(0.1)
        end
    end)
end

