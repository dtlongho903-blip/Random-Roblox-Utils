local function equipTool(toolName)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if character and character:FindFirstChildOfClass("Humanoid") then
        local tool = (backpack and backpack:FindFirstChild(toolName)) or (character and character:FindFirstChild(toolName))
        if tool and tool.Parent ~= character then
            character.Humanoid:EquipTool(tool)
            return tool
        end
        return character:FindFirstChild(toolName)
    end
    return nil
end

local function triggerAzureSkill(tool)
    if tool then
        local remote = tool:FindFirstChild("Remote")
        if remote then
            task.wait(0.04)
            remote:FireServer(Enum.KeyCode.E)
        end
    end
end

local function useIvorySkill()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Ivory Periastron") then
        local remote = character["Ivory Periastron"]:FindFirstChild("Remote")
        if remote then
            remote:FireServer(Enum.KeyCode.E)
            task.wait(0.01)
            remote:FireServer(Enum.KeyCode.E)
        end
    end
end

local function executeInstantAttack()
    local character = LocalPlayer.Character
    local tool = character and character:FindFirstChildOfClass("Tool")
    
    if tool then
        tool:Activate()
    else
        virtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.01)
        virtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end
end

local function executePerfectCancelParry()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChildOfClass("Humanoid") then return end
    local humanoid = character.Humanoid

    local currentTool = character:FindFirstChildOfClass("Tool")
    local previousToolName = currentTool and currentTool.Name or "Azure Periastron"

    if legitMode then
        task.wait(math.random(9, 18) / 100)
    end

    if parryMode == 1 then
        equipTool("Ivory Periastron")
        task.wait(0.02)
        useIvorySkill()
        task.wait(0.02)
        local azureTool = equipTool("Azure Periastron")
        triggerAzureSkill(azureTool)
    elseif parryMode == 2 then
        humanoid:UnequipTools()
        task.wait(0.02)
        local azureTool = equipTool("Azure Periastron")
        triggerAzureSkill(azureTool)
    end

    if isPerfectCancelToggled then
        task.spawn(function()
            if cancelDelay > 0 then task.wait(cancelDelay) end
            
            humanoid:UnequipTools()
            task.wait(0.015)
            equipTool(previousToolName)
            
            if isCounterAttackToggled then
                executeInstantAttack()
            end
        end)
    end
end

local function handleParryDetection(descendant)
    if not isParryToggled then return end
    
    local character = LocalPlayer.Character
    if not character then return end

    local id = ""
    if descendant:IsA("ParticleEmitter") then
        id = string.match(descendant.Texture, "%d+") or ""
    elseif descendant:IsA("MeshPart") or descendant:IsA("SpecialMesh") then
        id = string.match(descendant.MeshId, "%d+") or ""
