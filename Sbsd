local function isAdmin()
  local char = localPlayer.Character
  local head = char and char:FindFirstChild("Head")
  return head ~= nil and head:FindFirstChild("Antenna") ~= nil
end

local function hasGear()
  local backpack = localPlayer:FindFirstChildOfClass("Backpack")
  if backpack and backpack:FindFirstChild("RainbowPeriastron") then return true end
  local char = localPlayer.Character
  return char ~= nil and char:FindFirstChild("RainbowPeriastron") ~= nil
end

local function clickScreenCenter()
  local vp = workspace.CurrentCamera.ViewportSize
  local x, y = vp.X / 2, vp.Y / 2
  if mousemoveabs and mouse1click then
    mousemoveabs(x, y)
    task.wait(0.1)
    mouse1click()
  else
    virtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.05)
    virtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
  end
end

local FULLSCREEN_SIZE = UDim2.new(9999, 9999, 99999, 99999)

local function stretch(gui, size)
  if gui and gui:IsA("GuiObject") then
    gui.Visible = true
    gui.Position = UDim2.new(0, 0, 0, 0)
    gui.Size = size
    gui.ZIndex = 99999
    if gui:IsA("ScrollingFrame") then
      gui.CanvasPosition = Vector2.new(0, 0)
    end
  end
end

local function f33(btn)
  if not btn or not btn:IsA("GuiObject") then return false end
  local parent = btn.Parent
  if parent then
    for _, child in ipairs(parent:GetChildren()) do
      if child:IsA("UIGridLayout") or child:IsA("UIListLayout") then
        child:Destroy()
      end
    end
  end
  stretch(btn, UDim2.new(1, 0, 99999, 99999))
  local ancestor = parent
  for _ = 1, 3 do
    if not ancestor or ancestor:IsA("LayerCollector") then break end
    stretch(ancestor, FULLSCREEN_SIZE)
    ancestor = ancestor.Parent
  end
  local screenGui = btn:FindFirstAncestorWhichIsA("ScreenGui")
  if screenGui then screenGui.DisplayOrder = 99999 end
  task.wait(0.05)
  clickScreenCenter()
  return true
end

local charForcedTries = 0
local nextCharTry = 0

local function f34()
  if isAdmin() then return true end
  if tick() < nextCharTry then return false end

  local playerGui = getPlayerGui()
  local charClass = playerGui and playerGui:FindFirstChild("CharClass")
  if not charClass then return false end
  local scrollT2 = charClass:FindFirstChild("ScrollT2")
  local crossover = scrollT2 and scrollT2:FindFirstChild("crossover")
  local admin = crossover and crossover:FindFirstChild("Admin")
  if not admin then return false end
  local forced = not charClass.Enabled
  if forced then
    if charForcedTries >= 5 then return false end
    charForcedTries = charForcedTries + 1
    charClass.Enabled = true
  end
  nextCharTry = tick() + 1
  local scroll = charClass:FindFirstChild("Scroll")
  if scroll then scroll.Visible = false end
  scrollT2.Visible = true
  f33(admin)
  if forced then
    task.wait(0.2)
    if charClass.Parent then charClass.Enabled = false end
  end
  return true
end

local gearHandled = false

local function f35()
  local playerGui = getPlayerGui()
  local gears = playerGui and playerGui:FindFirstChild("gears")
  local scrollingFrame = gears and gears:FindFirstChild("ScrollingFrame")
  local item = scrollingFrame and scrollingFrame:FindFirstChild("RainbowPeriastron")
  if not item then return false end
  gears.Enabled = true
  f33(item)
  task.wait(0.3)
  return hasGear()
end

local function autoGearStep()
  local playerGui = getPlayerGui()
  if not playerGui then return end
  local gears = playerGui:FindFirstChild("gears")
  if hasGear() then
    if not gearHandled then
      gearHandled = true
      if gears then gears.Enabled = false end
      local char = localPlayer.Character
      local backpack = localPlayer:FindFirstChildOfClass("Backpack")
      local tool = backpack and backpack:FindFirstChild("RainbowPeriastron")
      if char and tool then tool.Parent = char end
    end
    return
  end
  gearHandled = false
  if not isAdmin() then return end
  if not gears then
    f24()
  else
    f35()
  end
end

