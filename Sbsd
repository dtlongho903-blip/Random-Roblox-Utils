-- HỆ THỐNG AUTO FARM & ORBIT (XOAY VÒNG CUNG TỪ MỌI HƯỚNG) [MỚI]
-----------------------------------------------------
local isFarmToggled = false
local isKillAllToggled = false
local loopConnection = nil
local angle = 0
local HEIGHT_OFFSET = -35
local selectedFarmMethod = "Magnet & Spin"
local isAutoSafeToggled = false
local safePositions = { Vector3.new(33.9, 52.0, 1815.7), Vector3.new(-220.8, 67.7, -1959.0) }
local currentSafePosIndex = 1
local lastHealth = 100
local lastDodge = 0
local cachedJoints = {}
local freezeCFrame = nil 

local function getGearFromParent(container)
  if not container then return nil end
  for _, child in ipairs(container:GetChildren()) do
      local lowerName = string.lower(child.Name)
      if string.find(lowerName, "rainbow") or string.find(lowerName, "whig") or string.find(lowerName, "trollge") then return child end
  end
  return nil
end

local function disableGrip(tool)
    local char = LocalPlayer.Character
    if not char or not tool then return end
    local handle = tool:FindFirstChild("Handle")
    for _, descendant in ipairs(char:GetDescendants()) do
        if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") or descendant:IsA("Motor6D") then
            if descendant.Name:find("RightGrip") or (handle and (descendant.Part0 == handle or descendant.Part1 == handle) and descendant.Parent ~= tool) then
                table.insert(cachedJoints, { joint = descendant, parent = descendant.Parent })
                descendant.Parent = nil
            end
        end
    end
end

local function enableGrip()
    for _, data in ipairs(cachedJoints) do pcall(function() data.joint.Parent = data.parent end) end
    cachedJoints = {}
end

local function restoreNPCs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(obj) then
            local hrp = obj.HumanoidRootPart
            hrp.Anchored = false; hrp.CanCollide = true; hrp.Size = Vector3.new(2, 2, 1); hrp.Transparency = 1
        end
    end
    enableGrip()
end

local function getActiveHandle()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            tool = getGearFromParent(backpack) or backpack:FindFirstChildOfClass("Tool")
            if tool then tool.Parent = char end
        end
    end
    
    if tool and tool:IsA("Tool") then
        disableGrip(tool)
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
        if handle then handle.Anchored = false; handle.CanCollide = false end
        return handle
    end
    return nil
end

local function startFarmLoop()
    if loopConnection then loopConnection:Disconnect() end
    
    loopConnection = runService.RenderStepped:Connect(function(deltaTime)
        local char = LocalPlayer.Character
        local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if not isFarmToggled and not isKillAllToggled then
            loopConnection:Disconnect()
            restoreNPCs()
            if playerRoot then playerRoot.Anchored = false end
            return
        end
        
        if playerRoot and humanoid then
            local toolPart = getActiveHandle()
            
            if isAutoSafeToggled and toolPart then
                playerRoot.Anchored = true
                if humanoid.Health < lastHealth and (tick() - lastDodge > 0.5) then
                    currentSafePosIndex = currentSafePosIndex == 1 and 2 or 1
                    lastDodge = tick()
                end
                playerRoot.CFrame = CFrame.new(safePositions[currentSafePosIndex])
            else
                playerRoot.Anchored = false
            end
            lastHealth = humanoid.Health
            
            angle = (angle + 3600 * deltaTime) % 360
            
            -- [MỚI] THÔNG SỐ VÒNG CUNG ORBIT
            local orbitRadius = 4.5 -- Bán kính vòng lượn quanh NPC
            local orbitRotation = CFrame.Angles(
                math.rad(angle * 2.7), -- Xoay trục X
                math.rad(angle * 4.1), -- Xoay trục Y
                math.rad(angle * 1.8)  -- Xoay trục Z (Tạo hiệu ứng quỹ đạo bay lượn ngẫu nhiên)
            )
            local orbitOffset = CFrame.new(0, 0, orbitRadius)
            local spinCFrame = CFrame.Angles(math.rad(angle * 12), math.rad(angle * 20), math.rad(angle * 15)) -- Tốc độ tự quay của vũ khí
            
            if selectedFarmMethod == "Magnet & Spin" then
                if toolPart then
                    toolPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    toolPart.AssemblyAngularVelocity = Vector3.new(1000, 10000, 1000)

                    local blackholeCFrame = playerRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, 0)
                    
                    -- [MỚI] Áp dụng vòng cung Orbit xung quanh tâm blackhole
                    toolPart.CFrame = blackholeCFrame * orbitRotation * orbitOffset * spinCFrame
                    
                    -- Gom tụi NPC vào một chỗ (tâm blackhole)
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and obj ~= char and obj.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(obj) then
                                local npcRoot = obj.HumanoidRootPart
                                npcRoot.Anchored = true; npcRoot.CanCollide = false
                                npcRoot.CFrame = blackholeCFrame * CFrame.Angles(0, math.rad(angle * 4), 0)
                            end
                        end
                    end
                else restoreNPCs() end
                
            elseif selectedFarmMethod == "Bring & Freeze" then
                if freezeCFrame == nil and playerRoot then freezeCFrame = playerRoot.CFrame * CFrame.new(0, 0, -4) end
                if freezeCFrame then
                    if toolPart then
                        toolPart.AssemblyLinearVelocity = Vector3.zero
                        toolPart.AssemblyAngularVelocity = Vector3.new(1000, 10000, 1000)
                        
                        -- [MỚI] Áp dụng vòng cung Orbit xung quanh tâm freeze
                        toolPart.CFrame = freezeCFrame * orbitRotation * orbitOffset * spinCFrame
                    end

                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and obj ~= char and obj.Humanoid.Health > 0 then
                            if not Players:GetPlayerFromCharacter(obj) then
                                local npcRoot = obj.HumanoidRootPart
                                npcRoot.Anchored = true; npcRoot.CanCollide = false
                                npcRoot.CFrame = freezeCFrame
                            end
                        end
                    end
                else restoreNPCs() end
            end
        end
    end)
end

