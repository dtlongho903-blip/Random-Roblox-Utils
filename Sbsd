local gearHandled = false
local GEAR_NAMES = { "rainbowperiastron", "trollge_tui axe", "whig sword", "dragonslayersswordandshield", "uppersword", "periastron" }

local function findGear(container, className, deep)
  if not container then return nil end
  local list = deep and container:GetDescendants() or container:GetChildren()
  for _, gearName in ipairs(GEAR_NAMES) do
    for _, obj in ipairs(list) do
      if obj:IsA(className) and string.find(string.lower(obj.Name), gearName, 1, true) then return obj end
    end
  end
  return nil
end

local function hasGear()
  local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
  if backpack and findGear(backpack, "Tool") then return true end
  local char = LocalPlayer.Character
  return char ~= nil and findGear(char, "Tool") ~= nil
end

