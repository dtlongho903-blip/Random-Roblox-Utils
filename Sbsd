local function disableGrip(tool)
    local char = LocalPlayer.Character
    if not char or not tool then return end
    local handle = tool:FindFirstChild("Handle")
    for _, descendant in ipairs(char:GetDescendants()) do
        if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") or descendant:IsA("Motor6D") then
            if descendant.Name:find("RightGrip") or (handle and (descendant.Part0 == handle or descendant.Part1 == handle) and descendant.Parent ~= tool) then
                if descendant.Parent ~= nil then
                    table.insert(cachedJoints, { joint = descendant, parent = descendant.Parent })
                    descendant.Parent = nil
                end
            end
        end
    end
end

local function enableGrip()
    for _, data in ipairs(cachedJoints) do
        if data.joint and data.parent and data.parent.Parent then
            pcall(function() data.joint.Parent = data.parent end)
        end
    end
    cachedJoints = {}
end

local function restoreNPCs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(obj) then
                local hrp = obj.HumanoidRootPart
                hrp.Anchored = false
                hrp.CanCollide = true
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
            end
        end
    end
    enableGrip()
end

local function getActiveHandle()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local tool = char:FindFirstChildOfClass("Tool")
    
    if not tool then
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            tool = getGearFromParent(backpack) or backpack:FindFirstChildOfClass("Tool")
            if tool then
                tool.Parent = char
            end
        end
    end
    
    if tool and tool:IsA("Tool") then
        disableGrip(tool)
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
        if handle then
            handle.Anchored = false
            handle.CanCollide = false
        end
        return handle
    end
    return nil
end

local function startFarmLoop()
    if loopConnection then loopConnection:Disconnect() end
    
    local lastTeleportTime = 0
    local currentTargetIndex = 1
    
    loopConnection = runService.RenderStepped:Connect(function(deltaTime)
        local char = LocalPlayer.Character
        local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        if not isFarmToggled and not isKillAllToggled then
            loopConnection:Disconnect()
            restoreNPCs()
            if playerRoot then playerRoot.Anchored = false end
            return
        end
        
        if playerRoot and humanoid then
            if lastHealth > humanoid.MaxHealth then lastHealth = humanoid.Health end
            
            local toolPart = nil
            if selectedFarmMethod == "Magnet & Spin" or selectedFarmMethod == "Bring & Freeze" then
                toolPart = getActiveHandle()
            end
            
            local holdingGear = (toolPart ~= nil)
            
            if PlaceId ~= 13151311229 and isAutoSafeToggled and holdingGear then
                playerRoot.Anchored = true
                if humanoid.Health < lastHealth and (tick() - lastDodge > 0.5) then
                    currentSafePosIndex = currentSafePosIndex == 1 and 2 or 1
                    lastDodge = tick()
                end
                playerRoot.CFrame = CFrame.new(safePositions[currentSafePosIndex])
                lastHealth = humanoid.Health
            else
                playerRoot.Anchored = false
                lastHealth = humanoid.Health
            end
            
            angle = (angle + 3600 * deltaTime) % 360
            
            if selectedFarmMethod == "Magnet & Spin" then
                if toolPart then
                    toolPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    toolPart.AssemblyAngularVelocity = Vector3.new(1000, 10000, 1000)

                    local blackholeCFrame = playerRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, 0)
                    local spinCFrame = CFrame.Angles(math.rad(angle * 2), math.rad(angle * 5), math.rad(angle * 3))
                    toolPart.CFrame = blackholeCFrame * spinCFrame
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                            if obj ~= char and obj.Humanoid.Health > 0 then
                                local isPlayer = Players:GetPlayerFromCharacter(obj)
                                if (isFarmToggled and not isPlayer) or isKillAllToggled then
                                    local npcRoot = obj.HumanoidRootPart
                                    npcRoot.Anchored = true
                                    npcRoot.CanCollide = false
                                    npcRoot.CFrame = blackholeCFrame * CFrame.Angles(0, math.rad(angle * 4), 0)
                                end
                            end
                        end
                    end
                else
                    restoreNPCs()
                end
                
            elseif selectedFarmMethod == "Bring & Freeze" then
                if freezeCFrame == nil and playerRoot then
                    freezeCFrame = playerRoot.CFrame * CFrame.new(0, 0, -4)
                end
                
                if freezeCFrame then
                    if toolPart then
                        toolPart.AssemblyLinearVelocity = Vector3.zero
                        toolPart.AssemblyAngularVelocity = Vector3.new(1000, 10000, 1000)
                        local spinCFrame = CFrame.Angles(math.rad(angle * 2), math.rad(angle * 5), math.rad(angle * 3))
                        toolPart.CFrame = freezeCFrame * spinCFrame
                    end

                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                            if obj ~= char and obj.Humanoid.Health > 0 then
                                local isPlayer = Players:GetPlayerFromCharacter(obj)
                                if (isFarmToggled and not isPlayer) or isKillAllToggled then
                                    local npcRoot = obj.HumanoidRootPart
                                    npcRoot.Anchored = true
                                    npcRoot.CanCollide = false
                                    npcRoot.CFrame = freezeCFrame
                                end
                            end
                        end
                    end
                else
                    restoreNPCs()
                end
                
            elseif selectedFarmMethod == "autoclose" then
                local validTargets = {}
                
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                        if obj ~= char and obj.Humanoid.Health > 0 then
                            local isPlayer = Players:GetPlayerFromCharacter(obj)
                            local objNameLower = string.lower(obj.Name)
                            
                            if not string.find(objNameLower, "boombox") then
                                if (isFarmToggled and not isPlayer) or isKillAllToggled then
                                    local npcRoot = obj.HumanoidRootPart
                                    npcRoot.Size = Vector3.new(15, 15, 15)
                                    npcRoot.Transparency = 0.5
                                    
                                    if string.find(objNameLower, "box") then
                                        table.insert(validTargets, obj)
                                    end
                                end
                            end
                        end
                    end
                end
                
                if #validTargets > 0 then
                    if tick() - lastTeleportTime >= 0.1 then
                        lastTeleportTime = tick()
                        currentTargetIndex = currentTargetIndex + 1
                    end
                    
                    if currentTargetIndex > #validTargets then
                        currentTargetIndex = 1
                    end
                    
                    local targetNPC = validTargets[currentTargetIndex]
                    if targetNPC and targetNPC:FindFirstChild("HumanoidRootPart") then
                        playerRoot.CFrame = targetNPC.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        playerRoot.AssemblyLinearVelocity = Vector3.zero
                        
                        local boxPart = targetNPC:FindFirstChild("Box")
                        if boxPart then
                            local closePrompt = boxPart:FindFirstChild("Close")
                            if closePrompt and closePrompt:IsA("ProximityPrompt") then
                                if fireproximityprompt then
                                    fireproximityprompt(closePrompt)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

