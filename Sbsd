local function f33(btn)
  if not btn or not btn:IsA("GuiObject") then return false end
  local parent = btn.Parent
  if parent then for _, child in ipairs(parent:GetChildren()) do if child:IsA("UIGridLayout") or child:IsA("UIListLayout") then child:Destroy() end end end
  stretch(btn, UDim2.new(1, 0, 99999, 99999))
  local ancestor = parent
  for _ = 1, 3 do if not ancestor or ancestor:IsA("LayerCollector") then break end; stretch(ancestor, UDim2.new(9999, 9999, 99999, 99999)); ancestor = ancestor.Parent end
  if btn:FindFirstAncestorWhichIsA("ScreenGui") then btn:FindFirstAncestorWhichIsA("ScreenGui").DisplayOrder = 99999 end
  task.wait(0.05); clickScreenCenter()
  return true
