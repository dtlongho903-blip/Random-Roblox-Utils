local function executeInstantAttack()
    local character = LocalPlayer.Character
    local tool = character and character:FindFirstChildOfClass("Tool")
    
    if tool then
        tool:Activate()
    else
        virtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.01)
        virtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end
end

local function executePerfectCancelParry()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChildOfClass("Humanoid") then return end
    local humanoid = character.Humanoid

    local currentTool = character:FindFirstChildOfClass("Tool")
    local previousToolName = currentTool and currentTool.Name or "Azure Periastron"

    if legitMode then
        task.wait(math.random(9, 18) / 100)
    end

    if parryMode == 1 then
        equipTool("Ivory Periastron")
        task.wait(0.02)
        useIvorySkill()
        task.wait(0.02)
        local azureTool = equipTool("Azure Periastron")
        triggerAzureSkill(azureTool)
    elseif parryMode == 2 then
        humanoid:UnequipTools()
        task.wait(0.02)
        local azureTool = equipTool("Azure Periastron")
        triggerAzureSkill(azureTool)
    end

    -- PERFECT CANCEL PARRY LOGIC
    if isPerfectCancelToggled then
        task.spawn(function()
            if cancelDelay > 0 then task.wait(cancelDelay) end
            
            humanoid:UnequipTools()
            task.wait(0.015)
            equipTool(previousToolName)
            
            if isCounterAttackToggled then
                executeInstantAttack()
            end
        end)
    end
end

local function handleParryDetection(descendant)
    if not isParryToggled then return end
    
    local character = LocalPlayer.Character
    if not character then return end

    local id = ""
    if descendant:IsA("ParticleEmitter") then
        id = string.match(descendant.Texture, "%d+") or ""
    elseif descendant:IsA("MeshPart") or descendant:IsA("SpecialMesh") then
        id = string.match(descendant.MeshId, "%d+") or ""
    end

    if id == "214269134" then
        local parent = descendant.Parent
        if parent and parent.Name == "IFrame" and parent.Parent and parent.Parent.Name == "Torso" and parent.Parent.Parent == character then
            task.spawn(executePerfectCancelParry)
        end
    end
end

local toolConnection, descendantConnection
local function setupCharacterParry(character)
    if toolConnection then toolConnection:Disconnect() end
    if descendantConnection then descendantConnection:Disconnect() end

    toolConnection = character.ChildAdded:Connect(function(child)
        if isParryToggled and child:IsA("Tool") and child.Name == "Azure Periastron" then
            triggerAzureSkill(child)
        end
    end)

    descendantConnection = character.DescendantAdded:Connect(handleParryDetection)
end

