local v23 = 0
local v13 = tick()
local v24 = 0

local autoMapModeToggled = false
local autoCharToggled = false
local autoGearToggled = false

local lastErr = {}
local function safeRun(tag, fn)
  local ok, err = pcall(fn)
  if not ok then
    err = tostring(err)
    if lastErr[tag] ~= err then
      lastErr[tag] = err
    end
  end
end

local function autoMapModeStep()
  if f25() then
    if tick() - v23 >= 1 then
      v23 = tick()
      f29()
    end
  else
    if workspace:FindFirstChild("start") or workspace:FindFirstChild("nightmare") or workspace:FindFirstChild("wh") then
      if tick() - v13 >= 3 then
        if tick() - v24 >= 1 then
          v24 = tick()
          f30()
        end
      end
    end
  end
end

task.spawn(function()
  while task.wait(0.5) do
    if autoMapModeToggled then safeRun("AutoMapMode", autoMapModeStep) end
    if autoCharToggled then safeRun("AutoChar", f34) end
    if autoGearToggled then safeRun("AutoGear", autoGearStep) end
  end
end)

local isFarmToggled = false
local loopConnection = nil
local angle = 0
local HEIGHT_OFFSET = -35
local selectedFarmMethod = "Magnet & Spin"
local isAutoSafeToggled = false
local safePositions = { Vector3.new(33.9, 52.0, 1815.7), Vector3.new(-220.8, 67.7, -1959.0) }
local currentSafePosIndex = 1
local lastHealth = 100
local lastDodge = 0

local function restoreNPCs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            if not Players:GetPlayerFromCharacter(obj) then
                local hrp = obj.HumanoidRootPart
                hrp.Anchored = false
                hrp.CanCollide = true
            end
        end
    end
end

local function getActiveHandle()
    local char = localPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChild("RainbowPeriastron")
    if tool and tool:IsA("Tool") then
        local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
        if rightArm and rightArm:FindFirstChild("RightGrip") then rightArm.RightGrip:Destroy() end
        return tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function startFarmLoop()
    if loopConnection then loopConnection:Disconnect() end
    loopConnection = runService.RenderStepped:Connect(function(deltaTime)
        local char = localPlayer.Character
        local playerRoot = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if not isFarmToggled then
            loopConnection:Disconnect()
            restoreNPCs()
            if playerRoot then playerRoot.Anchored = false end
            return
        end
        if playerRoot and humanoid then
            if lastHealth > humanoid.MaxHealth then lastHealth = humanoid.Health end
            local holdingRainbow = (getActiveHandle() ~= nil)
            if isAutoSafeToggled and holdingRainbow then
                playerRoot.Anchored = true
                if humanoid.Health < lastHealth and (tick() - lastDodge > 0.5) then
                    currentSafePosIndex = currentSafePosIndex == 1 and 2 or 1
                    lastDodge = tick()
                end
                playerRoot.CFrame = CFrame.new(safePositions[currentSafePosIndex])
                lastHealth = humanoid.Health
            else
                playerRoot.Anchored = false
                lastHealth = humanoid.Health
            end
        end
        angle = (angle + 300 * deltaTime) % 360
        if selectedFarmMethod == "Magnet & Spin" then
            local periastronPart = getActiveHandle()
            if playerRoot and periastronPart then
                local blackholeCFrame = playerRoot.CFrame * CFrame.new(0, HEIGHT_OFFSET, 0)
                periastronPart.CanCollide = false
                periastronPart.CFrame = blackholeCFrame * CFrame.Angles(math.rad(angle), math.rad(angle * 1.5), math.rad(angle * 1.2))
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                        if not Players:GetPlayerFromCharacter(obj) and obj.Humanoid.Health > 0 then
                            local npcRoot = obj.HumanoidRootPart
                            npcRoot.Anchored = true
                            npcRoot.CanCollide = false
                            npcRoot.CFrame = blackholeCFrame
                        end
                    end
                end
            else
                restoreNPCs()
            end
        end
    end)
end

