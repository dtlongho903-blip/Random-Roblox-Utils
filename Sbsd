                hrp.Anchored = false
                hrp.CanCollide = true
            end
        end
    end
    enableGrip()
end

local function getActiveHandle()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local tool = char:FindFirstChildOfClass("Tool")
    
    if not tool then
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
