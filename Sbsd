local charForcedTries, nextCharTry = 0, 0
local function f34()
  if tick() < nextCharTry then return false end
  local playerGui = getPlayerGui()
  local charClass = playerGui and playerGui:FindFirstChild("CharClass")
  if not charClass then return false end
  local targetBtn = nil
  for _, desc in ipairs(charClass:GetDescendants()) do if desc:IsA("GuiObject") and desc.Name == selectedAutoChar then targetBtn = desc; break end end
  if not targetBtn then return false end

  if not charClass.Enabled then
    if charForcedTries >= 5 then return false end
    charForcedTries = charForcedTries + 1; charClass.Enabled = true
  end
  nextCharTry = tick() + 1
  for _, child in ipairs(charClass:GetChildren()) do if child:IsA("ScrollingFrame") then child.Visible = false end end
  local parent = targetBtn.Parent
  while parent and parent ~= charClass do if parent:IsA("ScrollingFrame") then parent.Visible = true end; parent = parent.Parent end
  f33(targetBtn)
  return true
end

